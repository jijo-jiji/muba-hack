# Copy to .env.local and fill in. The app runs without any of these, but nothing
# reaches Sui and the AI review falls back to canned results, both of which the
# UI says out loud.

# --- Sui network ---
NEXT_PUBLIC_SUI_NETWORK=testnet

# --- Deployed Move package ---
# Both must be a real 0x + 64 hex object id or the app refuses to broadcast.
# Get them from `sui client publish` and from creating the escrow vault.
NEXT_PUBLIC_PACKAGE_ID=
NEXT_PUBLIC_ESCROW_VAULT_ID=
NEXT_PUBLIC_TREASURY_ADDRESS=

# --- Gas relayer ---
# Base64 Ed25519 secret key for the wallet that pays network fees on behalf of
# users. It must hold testnet SUI. Without it, /api/sponsor reports that it
# cannot sponsor and no transaction is sent.
SPONSOR_PRIVATE_KEY_B64=

# --- Gonka Router (the AI review) ---
# Without a key the review falls back to canned results, labelled in the UI as
# "Demo data, not a live Gonka call".
GONKA_ROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKA_ROUTER_API_KEY=
GONKA_MODEL=moonshotai/Kimi-K2.6
